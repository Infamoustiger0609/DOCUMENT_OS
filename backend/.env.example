# Groq API key for LLM calls
GROQ_API_KEY=your_groq_api_key_here

# Supabase Postgres connection string (with pgvector enabled)
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres

# Supabase project URL and service role key, used for Supabase Storage (the "documents" bucket)
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Secret used to sign/verify JWTs issued by POST /auth/login and /auth/register.
# Required — there is no insecure fallback. Generate one with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_here

# Optional overrides for JWT signing.
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Comma-separated list of origins allowed to call this API (CORS). Defaults to the
# local Next.js dev server if unset. In production, set this to the real deployed
# frontend URL — never "*".
ALLOWED_ORIGINS=http://localhost:3000

# Optional. Sentry DSN for backend error tracking (error_tracking.py) — leave
# unset locally; Sentry init is skipped entirely when this is empty. Get one by
# creating a free Sentry project (Python / FastAPI platform) and set this in the
# Render dashboard for the deployed backend.
SENTRY_DSN=
# Tags Sentry events so local/staging/production errors are distinguishable.
ENVIRONMENT=development

# Optional (Windows local dev only): full path to tesseract.exe if it's not on PATH
TESSERACT_CMD=

# Optional (Windows local dev only): full path to Ghostscript's console binary
# (gswin64c.exe/gswin32c.exe) if it's not on PATH. Used by /tools/compress-pdf
# and (indirectly) /tools/ocr-pdf.
GHOSTSCRIPT_CMD=

# Optional: full path to LibreOffice's soffice binary if it's not on PATH
# (Windows local dev). Defaults to "soffice", which is on PATH inside the
# Docker image via apt-get's libreoffice-writer package. Used by
# /tools/docx-to-pdf.
LIBREOFFICE_CMD=

# Optional. How long a /tools/* output file is kept before the retention
# sweep deletes it (hours). Defaults to 24.
TOOLS_RETENTION_HOURS=24
